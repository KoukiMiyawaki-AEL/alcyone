{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // File-based routes must export `Route` alongside their component, and
      // the shadcn/ui generated files co-locate variants/managers with theirs.
      // Neither is something we can restructure, so the rule is pure noise here.
      "files": ["src/routes/**", "src/components/ui/**", "src/components/app/theme-provider.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
