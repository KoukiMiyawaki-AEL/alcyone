{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcyone",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-23",
  "assets": {
    // Only /api/* reaches the Hono Worker. Everything else is handled by the
    // asset worker, so unknown paths fall back to index.html and TanStack
    // Router renders them client-side instead of hitting Hono's notFound.
    // Note: matching requests are billed as Worker invocations, and on the free
    // plan they return 429 past the daily limit rather than falling back to
    // the asset worker. Static assets themselves are free and unmetered.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  // Daily at 03:00 UTC. Purges soft-deleted rows past the retention window —
  // see src/worker/scheduled.ts.
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
  },
  // Makes production stack traces map back to TypeScript source.
  "upload_source_maps": true,
  // Per-Cloudflare-location and eventually consistent — Cloudflare is explicit
  // that this is "not an accurate accounting system". It raises the cost of
  // abuse; it is not a quota. `period` accepts only 10 or 60.
  // One instance per user, holding that user's open tabs. SQLite-backed
  // because KV-backed namespaces are being wound down.
  "durable_objects": {
    "bindings": [{ "name": "USER_CHANNEL", "class_name": "UserChannel" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserChannel"] }],
  // Deleting R2 objects is the work that must not sit on the cron's critical
  // path: the number of objects is unbounded, and a retention job that times
  // out halfway is worse than one that hands the work off.
  // Exporting a user's data is several dependent steps against two different
  // stores. A Workflow makes each step's result durable, so a failure resumes
  // from the last completed step instead of re-reading the whole database.
  "workflows": [
    { "name": "alcyone-data-export", "binding": "DATA_EXPORT", "class_name": "DataExportWorkflow" },
  ],
  "queues": {
    "producers": [{ "queue": "alcyone-object-cleanup", "binding": "OBJECT_CLEANUP" }],
    "consumers": [
      {
        "queue": "alcyone-object-cleanup",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        // Deleting an object that is already gone is not an error, so retries
        // are safe. Three, then the dead letter queue — a message that cannot
        // be processed must stop costing retries and start being visible.
        "max_retries": 3,
        "dead_letter_queue": "alcyone-object-cleanup-dlq",
      },
    ],
  },
  "ratelimits": [
    {
      // Unauthenticated and brute-forceable, so keyed by IP.
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Authenticated but expensive: each call writes to R2. Keyed by user.
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      // Placeholder like database_id — no bucket has been created on a real
      // Cloudflare account. See docs/adr/0003-d1-local-only.md.
      "bucket_name": "alcyone-attachments",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      // Placeholder — see docs/adr/0003-d1-local-only.md. No D1 database has
      // been created on Cloudflare yet; this is local-dev only.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "database_name": "alcyone-db",
      "migrations_dir": "drizzle",
    },
  ],
}
