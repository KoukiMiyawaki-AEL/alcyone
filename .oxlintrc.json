{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Playwright fixtures take a callback named `use`, which the react plugin
      // reads as a hook call outside a component. There is no React here at all.
      "files": ["test/e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    },
    {
      // Structural cases the rule cannot be satisfied for: file-based routes
      // must export `Route` next to their component; shadcn/ui's generated
      // files co-locate variants and managers with theirs; a context provider
      // paired with its own hook is the idiomatic shape; and src/main.tsx is
      // the entry point, not a refresh boundary at all.
      "files": [
        "src/routes/**",
        "src/components/ui/**",
        "src/components/app/theme-provider.tsx",
        "src/features/auth/AuthProvider.tsx",
        "src/main.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
